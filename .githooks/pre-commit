#!/usr/bin/env bash
# Pre-commit hook: keep references/cli.md in sync with cli.py, lint markdown
# for stale CLI invocations, guard the fact base, and block commits that change
# doc-relevant source without updating the docs/ pages (documentation drift).
#
# Install (one-time):
#   git config core.hooksPath .githooks
#
# Both checks runnable manually:
#   python .claude/skills/job-application-tailor/scripts/gen_cli_reference.py
#   python .claude/skills/job-application-tailor/scripts/lint_cli_usage.py
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
SKILL="$REPO_ROOT/.claude/skills/job-application-tailor"
GEN="$SKILL/scripts/gen_cli_reference.py"
LINTER="$SKILL/scripts/lint_cli_usage.py"
REF="$SKILL/references/cli.md"

# Pick a Python interpreter (Windows ships `py`; Unix ships `python3`).
if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v py >/dev/null 2>&1; then
  PY=py
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  echo "pre-commit: no Python interpreter found on PATH" >&2
  exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# 1. Regenerate CLI reference if cli.py changed
if echo "$staged" | grep -qE '\.claude/skills/job-application-tailor/scripts/cli\.py$'; then
  echo "pre-commit: cli.py changed → regenerating references/cli.md"
  "$PY" "$GEN"
  if ! git diff --quiet -- "$REF"; then
    git add "$REF"
    echo "pre-commit: staged updated references/cli.md"
  fi
fi

# 2. Lint staged markdown for stale CLI invocations
md_files=$(echo "$staged" | grep -E '\.md$' || true)
if [ -n "$md_files" ]; then
  # shellcheck disable=SC2086
  "$PY" "$LINTER" $md_files
fi

# 3. Verify the reference is in sync (catches the case where someone edits
#    cli.py but doesn't stage the regenerated references/cli.md, or edits
#    references/cli.md by hand).
"$PY" "$GEN" --check

# 4. Fact-base consistency: a stale cv_fact_base.json must never be committed.
#    resources/ is git-ignored (personal CV data) and absent on a fresh clone,
#    so only run when both files are present.
FB_CHECK="$REPO_ROOT/tools/factbase_consistency.py"
MASTER_CV="$REPO_ROOT/resources/MASTER_CV.docx"
FACT_BASE="$REPO_ROOT/resources/cv_fact_base.json"
if [ -f "$MASTER_CV" ] && [ -f "$FACT_BASE" ]; then
  "$PY" "$FB_CHECK" "$MASTER_CV" "$FACT_BASE" --check-hash || {
    echo "pre-commit: cv_fact_base.json is out of sync with MASTER_CV.docx — re-extract it (do not refresh .cv_hash by hand)." >&2
    exit 1
  }
fi

# 5. Documentation drift gate. The docs/ pages (overview deck + technical
#    reference, EN + FR) are hand-authored prose and diagrams — a hook cannot
#    regenerate them. So instead of auto-fixing, block the commit when
#    doc-relevant SOURCE is staged but nothing under docs/ is, as a reminder to
#    keep the pages accurate. Bypass when a change genuinely doesn't touch the
#    docs:   DOCS_OK=1 git commit …
if [ -z "$DOCS_OK" ]; then
  doc_src=$(echo "$staged" | grep -E \
    -e '\.claude/skills/job-application-tailor/scripts/(cli|job_history_db)\.py$' \
    -e '\.claude/skills/[^/]+/SKILL\.md$' \
    -e '\.claude/skills/[^/]+/schemas/.*\.json$' \
    -e '\.claude/skills/job-application-tailor/config/settings\.default\.yaml$' \
    || true)
  docs_changed=$(echo "$staged" | grep -E '^docs/' || true)
  if [ -n "$doc_src" ] && [ -z "$docs_changed" ]; then
    echo "" >&2
    echo "pre-commit: documentation drift — these staged files feed the docs:" >&2
    echo "$doc_src" | sed 's/^/    /' >&2
    echo "" >&2
    echo "  …but nothing under docs/ is staged. Update the affected pages so they" >&2
    echo "  stay accurate (keep the EN and FR versions in step), then stage them:" >&2
    echo "    docs/job-prospecting-technical-reference.html   (+ .fr.html)" >&2
    echo "    docs/job-prospecting-with-ai.html               (+ .fr.html)  [if the pipeline/skills changed]" >&2
    echo "" >&2
    echo "  If this change genuinely does not affect the docs, bypass with:" >&2
    echo "    DOCS_OK=1 git commit …" >&2
    echo "" >&2
    exit 1
  fi
fi
